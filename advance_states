% ADVANCE_STATES
% ---------------------------------------------------------------
% Integrate the UAV state forward by one time step.
%
% The UAV uses a simple planar kinematic model:
%
%   x_dot   = v cos(psi)
%   y_dot   = v sin(psi)
%   psi_dot = omega
%   v_dot   = a
%
% Inputs:
%   uav   : current UAV state with fields x, y, psi, v
%   u_cmd : commanded control vector [omega_cmd; a_cmd]
%   dt    : simulation time step [s]
%   cfg   : configuration struct containing UAV limits
%
% The function enforces:
%   - maximum turn rate cfg.uav.omega_max
%   - maximum acceleration cfg.uav.a_max
%   - speed limits cfg.uav.v_min and cfg.uav.v_max
%
% Output:
%   uav : updated UAV state

function uav = advance_states(uav, u_cmd, dt, cfg)

% -------------------------------------------------------------------------
% Saturate commanded controls
% -------------------------------------------------------------------------
omega = min(max(u_cmd(1), -cfg.uav.omega_max), cfg.uav.omega_max);
a     = min(max(u_cmd(2), -cfg.uav.a_max),     cfg.uav.a_max);

% -------------------------------------------------------------------------
% Integrate planar kinematics
% -------------------------------------------------------------------------
uav.x = uav.x + uav.v * cos(uav.psi) * dt;
uav.y = uav.y + uav.v * sin(uav.psi) * dt;

uav.psi = wrapToPi(uav.psi + omega * dt);
uav.v   = uav.v + a * dt;

% -------------------------------------------------------------------------
% Enforce speed limits
% -------------------------------------------------------------------------
uav.v = min(max(uav.v, cfg.uav.v_min), cfg.uav.v_max);

end
